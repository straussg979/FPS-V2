# COLD SECTOR server settings. Copy to .env (next to package.json); every variable is optional.
# Real environment variables win over this file.

# Where people reach the site. Your domain goes here and nowhere else.
# An https:// address turns on Secure cookies and is the origin allowed to open the game connection.
# SITE_URL=https://play.example.org

# Who to believe about the visitor's address and scheme:
#   none (default)  - nobody; use the TCP peer address
#   cloudflare      - CF-Connecting-IP / X-Forwarded-Proto, only from Cloudflare's address ranges or this machine
#                     (a Cloudflare Tunnel connects from 127.0.0.1)
#   local           - X-Forwarded-For / X-Forwarded-Proto from a proxy on this machine (nginx, caddy)
# TRUSTED_PROXY=cloudflare
# Override Cloudflare's address ranges (comma separated CIDRs) if they change before this code does.
# CLOUDFLARE_IPS=

# Signs session cookies. Without it a random key is generated once into user/secret_key.
# SECRET_KEY=

# Postgres instead of the built-in SQLite file (user/web.db).
# DATABASE_URL=postgres://cold:sector@localhost:5432/coldsector

# Send cookies only over HTTPS. Default: on with an https SITE_URL or TRUSTED_PROXY=cloudflare.
# SESSION_COOKIE_SECURE=1

# Other origins allowed to open the game connection (comma separated).
# ALLOWED_ORIGINS=

# Address the server listens on. Keep 127.0.0.1 behind a tunnel; 0.0.0.0 inside Docker.
HOST=127.0.0.1
PORT=5000

# Matches at once (each runs in its own worker thread, about one CPU core when full).
MAX_MATCHES=4

# Simulation tick and snapshot rates (Hz), client interpolation delay (ms).
TICK_RATE=64
SNAPSHOT_RATE=32
INTERP_MS=100

# Failed log-ins per minute (per IP and per username) before a lockout.
LOGIN_ATTEMPTS=5

# Public servers started with the site (data/servers.json by default; empty for none).
# SERVERS_FILE=data/servers.json

# Seconds duel spectators watch behind the players.
# DUEL_SPECTATOR_DELAY=10

# WebSocket keep-alive ping interval in seconds (below Cloudflare's 100 s idle timeout).
# WS_PING_SECONDS=20

# Demos only: every round timer short.
# DEV_FAST_ROUNDS=0

# Cloudflare Tunnel token for docker compose (the cloudflared service).
# TUNNEL_TOKEN=
